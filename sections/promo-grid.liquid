<div class="homepage-container homepage-section-spacing">
  <div class="promo-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign block_st = block.settings
        assign bg_style = ''
        if block_st.custom_bg_color != blank
          assign bg_style = 'style="background-color: ' | append: block_st.custom_bg_color | append: ';"'
        endif
      -%}
      
      <div class="promo-card {% if block_st.custom_bg_color == blank %}{{ block_st.bg_class_name }}{% endif %}" {{ bg_style }} {{ block.shopify_attributes }}>
        
        <div class="promo-info">

          <div class="promo-heading-group">
            {%- if block_st.label != blank -%}
              <span class="promo-label">{{ block_st.label | escape }}</span>
            {%- endif -%}

            {%- if block_st.title != blank -%}
              <h3 class="promo-heading">{{ block_st.title | escape }}</h3>
            {%- endif -%}
          </div>

          {%- if block_st.subtitle != blank -%}
            <span class="promo-subtitle">{{ block_st.subtitle | escape }}</span>
          {%- endif -%}

          {%- if block_st.link_url != blank -%}
            <a href="{{ block_st.link_url }}" class="promo-link">
              {{ block_st.link_text | default: 'Shop Now' | escape }}
              <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 5H11M11 5L7 1M11 5L7 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}

        </div>
        
        <div class="promo-image-wrap">
          {%- if block_st.image != blank -%}
            <img src="{{ block_st.image | image_url: width: 300 }}"
                 alt="{{ block_st.image.alt | default: block_st.title | escape }}"
                 loading="lazy"
                 width="120"
                 height="120"
                 class="promo-image">
          {%- else -%}
            {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg promo-image' }}
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo Banner Grid",
  "tag": "section",
  "class": "section-promo-grid",
  "max_blocks": 6,
  "settings": [],
  "blocks": [
    {
      "type": "promo_item",
      "name": "Promo Banner",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (dòng nhỏ trên)",
          "default": "Trending"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading (dòng to dưới)",
          "default": "New Phone Pro"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sub Text",
          "default": "Save 20% On Products"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Graphic Image"
        },
        {
          "type": "select",
          "id": "bg_class_name",
          "label": "Preset Background Theme",
          "options": [
            { "value": "promo-purple", "label": "Purple Pastel" },
            { "value": "promo-pink", "label": "Pink Pastel" },
            { "value": "promo-blue", "label": "Blue Pastel" }
          ],
          "default": "promo-purple"
        },
        {
          "type": "color",
          "id": "custom_bg_color",
          "label": "Custom Background Color (Overrides preset)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Banner Grid",
      "blocks": [
        {
          "type": "promo_item",
          "settings": {
            "label": "Trending",
            "title": "New Phone Pro",
            "subtitle": "Save 20% On Products",
            "bg_class_name": "promo-purple"
          }
        },
        {
          "type": "promo_item",
          "settings": {
            "label": "Top Product",
            "title": "MateBook Pro 2022",
            "subtitle": "Top Quality Products",
            "bg_class_name": "promo-pink"
          }
        },
        {
          "type": "promo_item",
          "settings": {
            "label": "iPad Pro",
            "title": "Up To 20% Off",
            "subtitle": "20 Days Return Products",
            "bg_class_name": "promo-blue"
          }
        }
      ]
    }
  ]
}
{% endschema %}