          "id": "sub_heading",
          "label": "Sub Heading",
          "default": "UP TO 50% OFF TODAY"
        },
        {
          "type": "color",
          "id": "subhead_color",
          "label": "Sub Heading Color",
          "default": "#FFC107"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "Main Heading",
          "default": "<p>Play Station 5 <span class=\"neon-green\">Dual Sense</span> Wireless Controller</p>"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Immerse yourself in a gaming experience with a controller that supports tactile feedback and dynamic trigger effects."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
