{%- comment -%}
  Renders rating stars for a product card.
  Accepts:
  - card_product: {Object} Product object (optional)
{%- endcomment -%}

{%- liquid
  assign rating_value = 5.0
  assign review_count = 68

  if card_product != blank
    if card_product.metafields.reviews.rating.value != blank
      assign rating_value = card_product.metafields.reviews.rating.value.rating | default: 5.0
      assign review_count = card_product.metafields.reviews.rating.value.count | default: 68
    elsif card_product.metafields.judgeme.badge != blank
      # Extract rating from judgeme badge if available
      # For demo, if badge exists we can use default rating or parse if needed
      assign review_count = 68
    else
      # Generates a stable review count based on product id
      assign temp_id = card_product.id | modulo: 80 | plus: 15
      assign review_count = temp_id
    endif
  endif
-%}

<div class="rating-stars flex align-center gap-5" style="display: inline-flex; align-items: center; gap: 5px;">
  <div class="stars flex align-center text-yellow" style="color: #ffb400; display: inline-flex; align-items: center;">
    {%- for i in (1..5) -%}
      {%- liquid
        assign diff = rating_value | minus: i | plus: 1
      -%}
      {%- if diff >= 1 -%}
        <!-- Full Star -->
        <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20" style="width: 14px; height: 14px;">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
        </svg>
      {%- elsif diff > 0.25 -%}
        <!-- Half Star -->
        <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20" style="width: 14px; height: 14px; position: relative;">
          <defs>
            <linearGradient id="halfStarGrad-{{ card_product.id }}-{{ i }}">
              <stop offset="50%" stop-color="#ffb400"/>
              <stop offset="50%" stop-color="#d1d5db"/>
            </linearGradient>
          </defs>
          <path fill="url(#halfStarGrad-{{ card_product.id }}-{{ i }})" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
        </svg>
      {%- else -%}
        <!-- Empty Star -->
        <svg width="14" height="14" fill="#d1d5db" viewBox="0 0 20 20" style="width: 14px; height: 14px;">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
        </svg>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <span class="rating-count text-grey fs-13" style="color: #888888; font-size: 13px; font-weight: 400;">({{ review_count }})</span>
</div>
