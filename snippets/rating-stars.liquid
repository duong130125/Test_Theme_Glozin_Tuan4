{%- comment -%}
  Renders rating stars for a product card.
  Accepts:
  - card_product: {Object} Product object (optional)
{%- endcomment -%}

{%- liquid
  assign rating_value = 5.0
  assign short_rating_count = 68

  if card_product != blank
    if card_product.metafields.reviews.rating.value != blank
      assign rating_value = card_product.metafields.reviews.rating.value.rating | default: 5.0
      assign short_rating_count = card_product.metafields.reviews.rating.value.count | default: 68
    endif

    if card_product.metafields.custom.short_rating_count.value != blank
      assign short_rating_count = card_product.metafields.custom.short_rating_count.value
    elsif short_rating_count == 68
      assign short_rating_count = card_product.id | modulo: 80 | plus: 15
    endif
  endif
-%}

<div class="rating-stars">
  <div class="rating-stars__icons">
    {%- for i in (1..5) -%}
      {%- liquid
        assign diff = rating_value | minus: i | plus: 1
      -%}
      {%- if diff >= 1 -%}
        <svg class="star-icon" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg">
          <path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329l-24.6 145.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329l104.2-103.1c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7l-143.7-21.2L316.9 18z"/>
        </svg>
      {%- elsif diff > 0.25 -%}
        <svg class="star-icon" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="half-{{ card_product.id }}-{{ i }}" x1="0" x2="1" y1="0" y2="0">
              <stop offset="50%" stop-color="#FFB800"/>
              <stop offset="50%" stop-color="#D1D5DB"/>
            </linearGradient>
          </defs>
          <path fill="url(#half-{{ card_product.id }}-{{ i }})" d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329l-24.6 145.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329l104.2-103.1c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7l-143.7-21.2L316.9 18z"/>
        </svg>
      {%- else -%}
        <svg class="star-icon star-icon--empty" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg">
          <path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329l-24.6 145.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329l104.2-103.1c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7l-143.7-21.2L316.9 18z"/>
        </svg>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if show_reviews_text -%}
    <span class="rating-stars__count">{{ short_rating_count }} reviews</span>
  {%- else -%}
    <span class="rating-stars__count">({{ short_rating_count }})</span>
  {%- endif -%}
</div>
